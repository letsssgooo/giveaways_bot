# Required. Fill locally; never commit real credentials.
# Keep secret values single-quoted when loading this file in a shell.
TELEGRAM_BOT_TOKEN=''
# PostgreSQL URL: postgres://user:password@host:5432/database?sslmode=disable
# Percent-encode special characters in the username and password.
# Choose sslmode according to the database deployment.
DATABASE_URL=''
# For Compose use the same credentials with host postgres and port 5432.
DOCKER_DATABASE_URL=''

# Local PostgreSQL container. Keep these credentials consistent with the URLs.
POSTGRES_USER=giveaways
POSTGRES_DB=giveaways
POSTGRES_PASSWORD=''
POSTGRES_PORT=5432

# Optional bootstrap administrators: comma-separated numeric Telegram user IDs.
# Empty means nobody receives administrator rights from the environment.
ADMIN_TELEGRAM_IDS=''

# Optional defaults. A supplied empty value is invalid.
LOG_LEVEL=INFO
# Time allowed for in-flight operations after intake stops.
SHUTDOWN_TIMEOUT=10s
# Docker stop grace must exceed SHUTDOWN_TIMEOUT; leaves time to close resources.
BOT_STOP_GRACE_PERIOD=60s
TELEGRAM_POLL_TIMEOUT=30s
TELEGRAM_REQUEST_TIMEOUT=40s
